DB_NAME=asiscontrol
DB_USER=asiscontrol
DB_PASSWORD=change-me-development-only
MYSQL_ROOT_PASSWORD=change-root-password
DB_PORT=3306

# 32 bytes encoded as Base64. Generate outside Git and never commit the value.
MFA_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173

# Disabled unless an administrator intentionally enables the one-time operation.
ASIS_BOOTSTRAP_ENABLED=false
ASIS_BOOTSTRAP_USERNAME=admin
ASIS_BOOTSTRAP_EMAIL=
ASIS_BOOTSTRAP_PASSWORD_FILE=
ASIS_RECOVERY_ENABLED=false
ASIS_RECOVERY_USERNAME=
ASIS_RECOVERY_PASSWORD_FILE=
ASIS_RECOVERY_RESET_MFA=false
